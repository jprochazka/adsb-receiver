{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Portal Backend",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}/build/portal/backend",
      "env": {
        "FLASK_APP": "backend",
        "FLASK_RUN_HOST": "127.0.0.1",
        "FLASK_RUN_PORT": "5000"
      },
      "args": ["run", "--no-reload"],
      "jinja": true,
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Portal Frontend",
      "type": "node-terminal",
      "request": "launch",
      "command": "./node_modules/.bin/ng serve --host 127.0.0.1 --port 4200",
      "cwd": "${workspaceFolder}/build/portal/frontend",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Local:\\s+(https?://\\S+)"
      }
    }
  ],
  "compounds": [
    {
      "name": "Portal Full Stack",
      "configurations": [
        "Portal Backend",
        "Portal Frontend"
      ]
    }
  ]
}
